# Public browser configuration. The build also falls back to ../desktop/.env.
CLERK_PUBLISHABLE_KEY=pk_test_...
CONVEX_URL=https://your-deployment.convex.cloud
# Optional overrides. The build discovers the Account Portal URL from Clerk.
# Development: sync from the sign-in website. Production: use your Clerk API domain.
CLERK_SYNC_HOST=https://your-instance.accounts.dev
CLERK_SIGN_IN_URL=https://your-instance.accounts.dev/sign-in
