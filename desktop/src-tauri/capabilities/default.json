{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FocusLock desktop capabilities",
  "windows": ["main", "blocker", "browser-repair"],
  "permissions": [
    "core:default",
    "store:default",
    { "identifier": "http:default", "allow": [{ "url": "https://*" }] },
    { "identifier": "http:default", "allow": [{ "url": "http://localhost:*" }] }
  ]
}
