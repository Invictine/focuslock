{
  "name": "focuslock-desktop",
  "private": true,
  "version": "0.6.18",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/generate-theme.mjs --check",
    "prebuild": "node ../scripts/generate-theme.mjs --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "void:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-focuslock-void.ps1",
