<Window x:Class="VoidApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Void" WindowStyle="None" ResizeMode="NoResize" Background="Black" Foreground="White" FontFamily="Segoe UI" ShowInTaskbar="True" Topmost="False">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="Black" />
   <Setter Property="FontSize" Value="16" /><Setter Property="Padding" Value="16,10" />
   <Setter Property="Opacity" Value="0.8" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="#242424" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <StackPanel x:Name="Menu" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
   <TextBlock x:Name="Heading" Text="FOCUS" FontSize="16" TextAlignment="Center" Margin="0,0,0,12" />
   <TextBlock x:Name="TodaySummary" FontSize="13" Foreground="#AAAAAA" TextAlignment="Center" Margin="0,0,0,24" />
   <ListBox x:Name="Choices" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="24" HorizontalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="16,9" /><Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.55" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" /></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Opacity" Value="1" /></Trigger></Style.Triggers>
     </Style>
    </ListBox.ItemContainerStyle>
   </ListBox>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
    <Button Content="Settings &amp; apps" Click="Settings_Click" />
    <Button Content="History" Click="History_Click" />
   </StackPanel>
   <Button Content="Back to desktop" Click="Minimize_Click" Margin="0,12,0,0" />
  </StackPanel>
  <StackPanel x:Name="DurationPanel" Visibility="Collapsed" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
   <TextBlock x:Name="DurationContext" FontSize="16" TextAlignment="Center" Margin="0,0,0,20" />
   <TextBlock Text="How long do you want to stay?" FontSize="20" TextAlignment="Center" Margin="0,0,0,24" />
   <TextBox x:Name="MinutesInput" AutomationProperties.Name="Duration in minutes" Text="25" Width="160" FontSize="32" TextAlignment="Center" Background="Black" Foreground="White" CaretBrush="White" BorderThickness="0" MaxLength="6" />
   <TextBlock Text="minutes" FontSize="13" Foreground="#999999" TextAlignment="Center" Margin="0,6,0,20" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
    <Button Content="15" Tag="15" Click="Preset_Click" AutomationProperties.Name="15 minutes"/>
    <Button Content="25" Tag="25" Click="Preset_Click" AutomationProperties.Name="25 minutes"/>
    <Button Content="50" Tag="50" Click="Preset_Click" AutomationProperties.Name="50 minutes"/>
   </StackPanel>
   <CheckBox x:Name="CloseAppsChoice" Content="Ask other apps to close" HorizontalAlignment="Center" />
   <TextBlock Text="Save prompts remain available." FontSize="13" Foreground="#AAAAAA" TextAlignment="Center" Margin="0,0,0,16" />
   <Button x:Name="StartButton" Content="Start focus" Click="StartBlock_Click" />
   <Button Content="Back" Click="Back_Click" />
  </StackPanel>
  <StackPanel x:Name="SessionPanel" Visibility="Collapsed" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
   <TextBlock x:Name="SessionContext" FontSize="16" TextAlignment="Center" Margin="0,0,0,18" />
   <TextBlock x:Name="TimerText" Text="25:00" FontSize="38" TextAlignment="Center" />
   <ProgressBar x:Name="SessionProgress" Minimum="0" Maximum="100" Height="2" Margin="40,18,40,0" Foreground="White" Background="#333333" BorderThickness="0" />
   <TextBlock x:Name="TimerHint" FontSize="13" Foreground="#999999" TextAlignment="Center" Margin="0,10,0,24" />
   <Button x:Name="ResumeButton" Content="Return to app" Click="Resume_Click" />
   <Button x:Name="NewBlockButton" Content="Choose another block" Visibility="Collapsed" Click="NewBlock_Click" />
   <Button x:Name="DesktopButton" Content="Back to desktop" Visibility="Collapsed" Click="Minimize_Click" />
   <Button x:Name="BreakButton" Content="Take a break" Visibility="Collapsed" Click="Break_Click" />
   <Button x:Name="SessionExit" Content="Exit Focus" PreviewMouseLeftButtonDown="Exit_MouseDown" Margin="0,10,0,0" />
  </StackPanel>
  <StackPanel x:Name="BreakPanel" Visibility="Collapsed" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
   <TextBlock Text="TAKE A BREATH" FontSize="16" TextAlignment="Center" Margin="0,0,0,18"/>
   <TextBlock x:Name="BreakTimerText" FontSize="38" TextAlignment="Center"/>
   <TextBlock x:Name="BreakHint" Text="Stretch, get water, rest your eyes." Foreground="#AAAAAA" TextAlignment="Center" Margin="0,14,0,24"/>
   <Button Content="Choose next block" Click="EndBreak_Click"/>
   <Button Content="Exit Void" Click="BreakExit_Click"/>
  </StackPanel>
  <StackPanel x:Name="ExitPanel" Visibility="Collapsed" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
   <TextBlock Text="Exit focus mode?" FontSize="24" TextAlignment="Center" Margin="0,0,0,24" />
   <TextBlock Text="Type EXIT, then press Enter." FontSize="14" TextAlignment="Center" Margin="0,0,0,18" />
   <TextBox x:Name="ExitText" FontSize="24" TextAlignment="Center" Background="Black" Foreground="White" CaretBrush="White" BorderThickness="0" MaxLength="4" />
   <TextBlock Text="Escape to cancel" FontSize="13" Foreground="#999999" TextAlignment="Center" Margin="0,24,0,0" />
  </StackPanel>
  <TextBlock x:Name="Status" Width="440" FontSize="13" Foreground="#BBBBBB" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72" />
  <TextBlock Text="Ctrl+Alt+Space · return to Void     |     Ctrl+Alt+Shift+F12 · emergency exit" FontSize="12" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,28"/>
 </Grid>
</Window>
