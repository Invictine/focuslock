<Window x:Class="VoidApp.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Void settings" Width="850" Height="720" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner"
 Background="{StaticResource SurfaceBrush}" Foreground="White" FontFamily="Segoe UI" FontSize="14" Topmost="True">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Make room for your work" FontSize="26"/>
   <TextBlock Text="Choose your apps and how a focus block behaves." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="0,0,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Your apps" FontSize="19" Margin="0,0,0,12"/>
     <ListBox x:Name="AppList" Height="150" Background="#181818" Foreground="White" BorderBrush="#555555" SelectionChanged="AppList_SelectionChanged" AutomationProperties.Name="Configured apps"/>
     <WrapPanel Margin="0,8,0,0">
      <Button Content="New" Click="New_Click" Margin="0,0,6,6"/>
      <Button Content="Remove" Click="Remove_Click" Margin="0,0,6,6"/>
      <Button Content="↑" Click="Up_Click" AutomationProperties.Name="Move app up" Margin="0,0,6,6"/>
      <Button Content="↓" Click="Down_Click" AutomationProperties.Name="Move app down" Margin="0,0,0,6"/>
     </WrapPanel>
     <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="AppNameInput" AutomationProperties.Name="App display name" MaxLength="80"/>
     <TextBlock Text="Executable path or packaged app ID" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="TargetInput" AutomationProperties.Name="App target"/>
     <Button Content="Browse for an app…" Click="Browse_Click" Margin="0,8,0,0"/>
     <TextBlock Text="Or choose an installed Windows app" Style="{StaticResource FieldLabel}"/>
     <ComboBox x:Name="PackagedApps" AutomationProperties.Name="Installed Windows apps" SelectionChanged="PackagedApps_SelectionChanged" MinHeight="34"/>
     <TextBlock x:Name="DiscoveryHint" Foreground="{StaticResource MutedBrush}" Text="Loading installed apps…" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
     <TextBlock Text="Launch arguments (optional)" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="ArgsInput" AutomationProperties.Name="Launch arguments"/>
     <Button x:Name="ApplyAppButton" Content="Add app" Click="ApplyApp_Click" Margin="0,12,0,0"/>
     <TextBlock Text="Apply each app edit before saving settings." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="Focus preferences" FontSize="19" Margin="0,0,0,2"/>
     <TextBlock Text="Launcher heading" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="TitleInput" AutomationProperties.Name="Launcher heading" MaxLength="80"/>
     <TextBlock Text="Default focus duration · minutes" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="FocusMinutesInput" AutomationProperties.Name="Default focus minutes" MaxLength="4"/>
     <TextBlock Text="Break duration · minutes" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="BreakMinutesInput" AutomationProperties.Name="Break minutes" MaxLength="2"/>
     <CheckBox x:Name="GuardChoice" Content="Keep me in my chosen app" Margin="0,20,0,8"/>
     <TextBlock Text="Returns to Void when you switch to another app. All windows from the chosen executable are allowed." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
     <CheckBox x:Name="CloseChoice" Content="Ask other apps to close by default" Margin="0,16,0,8"/>
     <CheckBox x:Name="SoundChoice" Content="Play a sound when the timer ends"/>
     <CheckBox x:Name="StartupChoice" Content="Open Void when I sign in to Windows"/>
     <CheckBox x:Name="PrimaryMonitorChoice" Content="Use only the primary monitor"/>
     <TextBlock Text="Switches when Void opens and restores your display layout when you exit. Changes here apply next time you open Void." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
     <Separator Margin="0,20,0,12" Background="#333333"/>
     <TextBlock Text="Your data stays on this computer" Foreground="{StaticResource MutedBrush}"/>
     <TextBlock x:Name="StorageLocation" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,16"/>
     <TextBlock Text="Ctrl+Alt+Space returns to Void.&#10;Ctrl+Alt+Shift+F12 restores the taskbar and exits immediately." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFB6AB" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/>
   <Button Grid.Column="2" Content="Save settings" Click="Save_Click" BorderBrush="White"/>
  </Grid>
 </Grid>
</Window>
