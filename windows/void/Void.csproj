<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Void</AssemblyName>
    <RootNamespace>VoidApp</RootNamespace>
    <Version>1.3.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);work/**;portable/**;outputs/**;packaging/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
