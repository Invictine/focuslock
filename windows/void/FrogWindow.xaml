<Window x:Class="VoidApp.FrogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusLock Frog" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#0d0d0f" Foreground="#eee9e7" ShowInTaskbar="False" Topmost="True" Focusable="True"
        Closing="Window_Closing" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#eee9e7"/><Setter Property="Background" Value="#141416"/>
            <Setter Property="BorderBrush" Value="#353235"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#eee9e7"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="1" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <TextBlock Text="FOCUSLOCK FROG" Foreground="#dfbdb6" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="Your next task" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,5"/>
            <TextBlock x:Name="ProjectText" Text="" Foreground="#bbb4b1" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PhaseText" Text="FOCUS" Foreground="#bbb4b1" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TimerText" Text="00:00" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" Margin="0,16,0,3"/>
            <TextBlock x:Name="ProgressText" Text="0 / 0 minutes" Foreground="#bbb4b1" FontSize="13" HorizontalAlignment="Center"/>
            <CheckBox x:Name="TickBox" Content="Mark this task complete" HorizontalAlignment="Center" Checked="TickBox_Checked"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                <Button x:Name="TimerButton" Content="Start focus" MinWidth="148" Click="TimerButton_Click"/>
                <ComboBox x:Name="DurationBox" Width="118" Height="42" Margin="5" Background="#141416" Foreground="#eee9e7" SelectionChanged="DurationBox_SelectionChanged"/>
            </StackPanel>
            <TextBlock Text="APPROVED TOOLS" Foreground="#bbb4b1" FontSize="11" Margin="4,14,4,3"/>
            <WrapPanel x:Name="ToolsPanel" HorizontalAlignment="Center"/>
            <TextBlock Text="WEBSITES" Foreground="#bbb4b1" FontSize="11" Margin="4,10,4,3"/>
            <WrapPanel x:Name="DomainsPanel" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Open FocusLock" Click="OpenFocusLock_Click"/>
                <Button Content="Back to desktop" Click="CloseSurface_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="" Foreground="#e5c58f" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="8,14,8,0"/>
            <TextBlock x:Name="RecoveryText" Text="Ctrl+Alt+Space: return to FocusLock · Ctrl+Alt+Shift+F12: close this screen" Foreground="#bbb4b1" FontSize="11" TextAlignment="Center" Margin="8,18,8,0"/>
        </StackPanel>
    </Grid></ScrollViewer>
</Window>
