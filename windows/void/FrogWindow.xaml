<Window x:Class="VoidApp.FrogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FocusLock Frog" WindowStyle="None" ResizeMode="NoResize" Background="Black" Foreground="White" FontFamily="Segoe UI"
 ShowInTaskbar="False" Topmost="True" Closing="Window_Closing" Loaded="Window_Loaded" KeyDown="Window_KeyDown" PreviewMouseLeftButtonDown="Window_MouseDown">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Black"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Opacity" Value="0.7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#242424"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Black"/><Setter Property="CaretBrush" Value="White"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#333333"/><Setter Property="Padding" Value="8,12"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="8,10"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <StackPanel x:Name="GracePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
   <TextBlock Text="Eat the frog starts in" Foreground="#999999" FontSize="12" TextAlignment="Center"/>
   <TextBlock x:Name="GraceTimerText" FontSize="32" FontWeight="Light" TextAlignment="Center" Margin="0,4,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,32,0,80">
   <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="EAT THE FROG" Foreground="#888888" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,24"/>
     <TextBlock x:Name="TitleText" Text="Pick one task" FontSize="32" FontWeight="Light" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="ProjectText" Foreground="#999999" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"/>
     <TextBlock x:Name="PhaseText" Foreground="#999999" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"/>
     <StackPanel x:Name="PickerPanel" Visibility="Collapsed" Margin="0,24,0,0">
      <StackPanel x:Name="TaskStep">
       <TextBox x:Name="TaskInput" FontSize="24" MaxLength="200" Width="440" AutomationProperties.Name="Today's task"/>
       <Button Content="Continue" Click="Continue_Click" HorizontalAlignment="Center" Margin="0,20,0,0"/>
      </StackPanel>
      <StackPanel x:Name="ToolsStep" Visibility="Collapsed">
       <TextBlock Text="Only what you need" Foreground="#999999" TextAlignment="Center" Margin="0,0,0,12"/>
       <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="EssentialChoices"/></ScrollViewer>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Choose another app…" Click="BrowseEssential_Click"/>
        <Button Content="Installed apps…" Click="InstalledEssential_Click"/>
       </StackPanel>
       <TextBox x:Name="SitesInput" Width="440" FontSize="15" AutomationProperties.Name="Essential websites, separated by commas"/>
       <TextBlock Text="Websites, separated by commas" Foreground="#777777" FontSize="12" Margin="8,8,0,12"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Back" Click="BackToTask_Click"/>
        <Button x:Name="UseTaskButton" Content="Use this task" Click="UseTask_Click"/>
       </StackPanel>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="FocusPanel" Margin="0,24,0,0">
      <TextBlock x:Name="TimerText" Text="25:00" FontSize="64" FontWeight="Light" HorizontalAlignment="Center"/>
      <TextBlock x:Name="ProgressText" Foreground="#888888" FontSize="13" TextAlignment="Center" Margin="0,4,0,20"/>
      <StackPanel x:Name="TimerControls" Orientation="Horizontal" HorizontalAlignment="Center">
       <Button x:Name="TimerButton" Content="Start focus" Click="TimerButton_Click"/>
       <ComboBox x:Name="DurationBox" Width="88" Height="32" Margin="8" Background="Black" Foreground="White" SelectionChanged="DurationBox_SelectionChanged" AutomationProperties.Name="Focus block minutes"/>
      </StackPanel>
      <WrapPanel x:Name="ToolsPanel" HorizontalAlignment="Center" Margin="0,20,0,0"/>
      <WrapPanel x:Name="DomainsPanel" HorizontalAlignment="Center"/>
      <CheckBox x:Name="TickBox" Content="Task complete" HorizontalAlignment="Center" Checked="TickBox_Checked" Margin="0,24,0,0"/>
     </StackPanel>
     <TextBlock x:Name="StatusText" Foreground="#AAAAAA" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="8,18,8,0"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <StackPanel x:Name="FooterPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
   <Button Content="Open FocusLock" Click="OpenFocusLock_Click"/><Button Content="Back to desktop" Click="CloseSurface_Click"/>
  </StackPanel>
  <TextBlock x:Name="RecoveryText" Text="Ctrl+Alt+Space · return    |    Ctrl+Alt+Shift+F12 · close" Foreground="#666666" FontSize="11" TextAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
 </Grid>
</Window>
