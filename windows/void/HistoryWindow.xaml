<Window x:Class="VoidApp.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Void history" Width="760" Height="550" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterOwner" Topmost="True"
 Background="{StaticResource SurfaceBrush}" Foreground="White" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Time well spent" FontSize="26"/>
  <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,20" TextWrapping="Wrap"/>
  <ListView x:Name="SessionList" Grid.Row="2" Background="#181818" Foreground="White" BorderBrush="#444444" AutomationProperties.Name="Session history">
   <ListView.Resources><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#252525"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,8"/></Style></ListView.Resources>
   <ListView.View><GridView>
    <GridViewColumn Header="Started" DisplayMemberBinding="{Binding Started}" Width="165"/>
    <GridViewColumn Header="App" DisplayMemberBinding="{Binding AppName}" Width="210"/>
    <GridViewColumn Header="Focused" DisplayMemberBinding="{Binding Duration}" Width="110"/>
    <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="115"/>
   </GridView></ListView.View>
  </ListView>
  <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Your first completed block will appear here." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  <Grid Grid.Row="3" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
   <Button x:Name="ExportButton" Grid.Column="1" Content="Export CSV…" Click="Export_Click" Margin="0,0,10,0"/>
   <Button Grid.Column="2" Content="Close" Click="Close_Click"/>
  </Grid>
 </Grid>
</Window>
